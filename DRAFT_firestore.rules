rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- 1. GLOBAL SAFETY NET ---
    match /{document=**} {
      allow read, write: if false;
    }

    // --- 2. GLOBAL REUSABLE PRIMITIVES ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true && request.auth.token.email == 'daniel.ayuntnumancia@gmail.com';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Helper to get request payload
    function incoming() {
      return request.resource.data;
    }

    // Helper to get existing document data
    function existing() {
      return resource.data;
    }

    // --- 3. ENTITY VALIDATION BLUEPRINTS ---

    function isValidBillData(data) {
      return data.keys().hasOnly(['fechaInicio', 'fechaFin', 'presupuesto', 'kwPunta', 'kwValle', 'precioMargen', 'precioKwPunta', 'precioKwValle', 'kwhPunta', 'kwhLlano', 'kwhValle', 'precioKwhPunta', 'precioKwhLlano', 'precioKwhValle', 'costeEnergiaVariable', 'costeEnergiaPunta', 'costeEnergiaLlano', 'costeEnergiaValle', 'alqContador', 'bonoSocial', 'iee', 'ieeMinComunitario', 'iva', 'perfilTarifaId', 'nombreTarifa', 'descuentoEnergia', 'serviciosAdicionales'])
        && data.keys().hasAll(['fechaInicio', 'fechaFin', 'kwPunta', 'kwValle', 'kwhPunta', 'kwhLlano', 'kwhValle'])
        && data.fechaInicio is string && data.fechaInicio.size() <= 50
        && data.fechaFin is string && data.fechaFin.size() <= 50
        && data.kwPunta is number && data.kwPunta >= 0 && data.kwPunta <= 100
        && data.kwValle is number && data.kwValle >= 0 && data.kwValle <= 100
        && data.kwhPunta is number && data.kwhPunta >= 0 && data.kwhPunta <= 100000
        && data.kwhLlano is number && data.kwhLlano >= 0 && data.kwhLlano <= 100000
        && data.kwhValle is number && data.kwhValle >= 0 && data.kwhValle <= 100000;
    }

    function isValidBillResults(results) {
      return results.dias is number
        && results.totalFijo is number
        && results.fijoPunta is number
        && results.fijoValle is number
        && results.fijoMargen is number
        && results.totalVariable is number
        && results.totalPeajes is number
        && results.peajesPunta is number
        && results.peajesLlano is number
        && results.peajesValle is number
        && results.totalEnergia is number
        && results.energiaPunta is number
        && results.energiaLlano is number
        && results.energiaValle is number
        && results.totalIee is number
        && results.totalRegulados is number
        && results.totalIva is number
        && results.totalFactura is number
        && results.alertaPresupuesto is bool;
    }

    function isValidHistoryEntry(entry) {
      return entry.keys().hasOnly(['id', 'dateStr', 'timestamp', 'billData', 'results', 'tipo', 'mesFacturacion'])
        && entry.keys().hasAll(['id', 'dateStr', 'timestamp', 'billData', 'results', 'tipo'])
        && isValidId(entry.id)
        && entry.dateStr is string && entry.dateStr.size() <= 50
        && entry.timestamp is number
        && entry.tipo is string && (entry.tipo == 'simulacion' || entry.tipo == 'oficial')
        && isValidBillData(entry.billData)
        && isValidBillResults(entry.results);
    }

    function isValidSourceFile(source) {
      return source.keys().hasOnly(['id', 'name', 'timestamp', 'explanation', 'parsedData'])
        && source.keys().hasAll(['id', 'name', 'timestamp', 'explanation'])
        && isValidId(source.id)
        && source.name is string && source.name.size() <= 200
        && source.timestamp is number
        && source.explanation is string && source.explanation.size() <= 10000;
    }

    function isValidChatMessage(msg) {
      return msg.keys().hasOnly(['id', 'role', 'content', 'timestamp', 'citations', 'sourceFileId', 'imageUrl'])
        && msg.keys().hasAll(['id', 'role', 'content', 'timestamp'])
        && isValidId(msg.id)
        && msg.role is string && (msg.role == 'user' || msg.role == 'assistant')
        && msg.content is string && msg.content.size() <= 50000
        && msg.timestamp is string && msg.timestamp.size() <= 100;
    }

    function isValidTariffProfile(profile) {
      return profile.keys().hasAll(['id', 'nombre', 'comercializadora', 'modalidad', 'precioKwPunta', 'precioKwValle', 'costeEnergiaPunta', 'costeEnergiaLlano', 'costeEnergiaValle', 'timestamp'])
        && isValidId(profile.id)
        && profile.nombre is string && profile.nombre.size() >= 1 && profile.nombre.size() <= 120
        && profile.comercializadora is string && profile.comercializadora.size() <= 120
        && profile.modalidad is string && (profile.modalidad == 'pvpc' || profile.modalidad == 'fijo24h' || profile.modalidad == 'periodos3' || profile.modalidad == 'personalizado')
        && profile.precioKwPunta is number && profile.precioKwPunta >= 0 && profile.precioKwPunta <= 500
        && profile.precioKwValle is number && profile.precioKwValle >= 0 && profile.precioKwValle <= 500
        && profile.costeEnergiaPunta is number && profile.costeEnergiaPunta >= 0 && profile.costeEnergiaPunta <= 5
        && profile.costeEnergiaLlano is number && profile.costeEnergiaLlano >= 0 && profile.costeEnergiaLlano <= 5
        && profile.costeEnergiaValle is number && profile.costeEnergiaValle >= 0 && profile.costeEnergiaValle <= 5
        && profile.timestamp is number;
    }

    // --- 4. SECURE PATH MATCHES ---

    match /users/{userId} {
      
      // Permit active profile billData
      match /profile/billData {
        allow read: if isOwner(userId) && isEmailVerified();
        allow write: if isOwner(userId) && isEmailVerified() && isValidBillData(incoming());
      }

      // Permit history records
      match /history/{entryId} {
        allow get: if isOwner(userId) && isEmailVerified() && isValidId(entryId);
        allow list: if isOwner(userId) && isEmailVerified();
        allow create: if isOwner(userId) && isEmailVerified() && isValidId(entryId) && isValidHistoryEntry(incoming()) && incoming().id == entryId;
        allow update: if isOwner(userId) && isEmailVerified() && isValidId(entryId) && isValidHistoryEntry(incoming()) && incoming().id == entryId
                      && incoming().id == existing().id && incoming().timestamp == existing().timestamp; // immutable identity and creation time
        allow delete: if isOwner(userId) && isEmailVerified() && isValidId(entryId);
      }

      // Permit sources (parsed document files)
      match /sources/{sourceId} {
        allow get: if isOwner(userId) && isEmailVerified() && isValidId(sourceId);
        allow list: if isOwner(userId) && isEmailVerified();
        allow create: if isOwner(userId) && isEmailVerified() && isValidId(sourceId) && isValidSourceFile(incoming()) && incoming().id == sourceId;
        allow update: if isOwner(userId) && isEmailVerified() && isValidId(sourceId) && isValidSourceFile(incoming()) && incoming().id == sourceId
                      && incoming().id == existing().id && incoming().timestamp == existing().timestamp;
        allow delete: if isOwner(userId) && isEmailVerified() && isValidId(sourceId);
      }

      // Permit chat history
      match /chats/{chatId} {
        allow get: if isOwner(userId) && isEmailVerified() && isValidId(chatId);
        allow list: if isOwner(userId) && isEmailVerified();
        allow create: if isOwner(userId) && isEmailVerified() && isValidId(chatId) && isValidChatMessage(incoming()) && incoming().id == chatId;
        allow update: if isOwner(userId) && isEmailVerified() && isValidId(chatId) && isValidChatMessage(incoming()) && incoming().id == chatId
                      && incoming().id == existing().id && incoming().timestamp == existing().timestamp;
        allow delete: if isOwner(userId) && isEmailVerified() && isValidId(chatId);
      }

      // Permit tariff profiles (Mercado Libre & PVPC)
      match /tariffProfiles/{profileId} {
        allow get: if isOwner(userId) && isEmailVerified() && isValidId(profileId);
        allow list: if isOwner(userId) && isEmailVerified();
        allow create: if isOwner(userId) && isEmailVerified() && isValidId(profileId) && isValidTariffProfile(incoming()) && incoming().id == profileId;
        allow update: if isOwner(userId) && isEmailVerified() && isValidId(profileId) && isValidTariffProfile(incoming()) && incoming().id == profileId
                      && incoming().id == existing().id;
        allow delete: if isOwner(userId) && isEmailVerified() && isValidId(profileId);
      }
    }
  }
}
