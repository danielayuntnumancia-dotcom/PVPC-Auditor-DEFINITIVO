# Clave API de Gemini. Se debe configurar mediante Secrets en el entorno.
# ADVERTENCIA: No añadir una clave real a este repositorio o archivo.
GEMINI_API_KEY=

# Token de API de ESIOS (Red Eléctrica de España)
# Obtén tu token en: https://api.esios.ree.es/
ESIOS_API_TOKEN=

# Firebase Web App configuration
# Copia estos valores desde la consola de Firebase y añádelos a tu archivo .env local.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=(default)

# Opcional: URL base de la aplicación
# APP_URL=
